# Copy to .env.local (gitignored) and fill in. `supabase start` prints the
# local values for the first three; see README.md's "Admin" and "The signup
# flow" sections for what each one gates.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Bypasses row-level security. Used only by lib/supabase/admin.ts, only for
# the public signup flow (app/actions.ts's submitSignup) — an anonymous
# visitor creating a customer has no session for RLS to authorise against.
SUPABASE_SERVICE_ROLE_KEY=

# The site's own public origin (no trailing slash), e.g. https://odatone.com
# locally http://127.0.0.1:3000 (see supabase/config.toml's [auth].site_url,
# which must match). Used to build the invite email's redirect link
# (app/actions.ts). Left unset, the redirect becomes a bare relative path
# instead of a URL an email client can follow — submitSignup logs a warning
# every time it runs without this set.
NEXT_PUBLIC_SITE_URL=
